<?xml version="1.0" encoding="utf-8"?>
<!-- The tile behind the adaptive icon. A shape rather than a PNG so it stays
     crisp at whatever size a launcher decides to draw it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#3D7BE0"
        android:endColor="#1A4A9E"
        android:type="linear" />
</shape>
